---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FriendsBody from '../../components/FriendsBody.astro';
import type { Lang } from '../../i18n/translations';
import { LANGS_NO_EN, buildAlternates } from '../../i18n/utils';
import { friendsContent } from '../../i18n/friends-content';

export function getStaticPaths() {
  return LANGS_NO_EN.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const c = friendsContent[lang] ?? friendsContent['en'];
---

<Layout
  title={c.title}
  description={c.desc}
  canonical={`https://kulmanlab.com/${lang}/friends/`}
  lang={lang}
  alternates={buildAlternates('friends')}
>

  <SiteHeader lang={lang} />

  <FriendsBody lang={lang} />

  <SiteFooter lang={lang} />

</Layout>
