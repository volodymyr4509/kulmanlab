---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';
import { getCollection } from 'astro:content';
import { LANGS_NO_EN } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  entrySlug?: string;
  lang?: Lang;
}

const { title, description = '', keywords = [], entrySlug = '', lang = 'en' } = Astro.props;
const base = lang === 'en' ? '/docs' : `/${lang}/docs`;
const canonical = `https://kulmanlab.com${base}${entrySlug ? '/' + entrySlug : ''}/`;
// Same page in every language, for the hreflang cluster passed to Layout.
const docsTail = `/docs${entrySlug ? '/' + entrySlug : ''}/`;
const alternates = [
  { hreflang: 'x-default', href: `https://kulmanlab.com${docsTail}` },
  { hreflang: 'en', href: `https://kulmanlab.com${docsTail}` },
  ...LANGS_NO_EN.map(l => ({ hreflang: l, href: `https://kulmanlab.com/${l}${docsTail}` })),
];
const currentPath = Astro.url.pathname.replace(/\/$/, '');

// Section/group titles are centralized in src/i18n/translations.ts
// (docsNav.* keys) alongside the rest of the site's copy. Every nav *item*
// label (commands and interface pages alike -- Move, Align, LayerIsolate,
// Grid & Snap, Selection Filter, ...) is deliberately kept in English for
// every language: command names mirror the literal tokens typed into the
// in-app terminal, and interface page names follow the same convention for
// consistency, even though the docs content and page titles are translated.
const t = translations[lang] ?? translations['en'];
const s = {
  overview: t['docsNav.overview'],
  ref: t['docsNav.ref'],
  shapes: t['docsNav.shapes'],
  edit: t['docsNav.edit'],
  markup: t['docsNav.markup'],
  layer: t['docsNav.layer'],
  layouts: t['docsNav.layouts'],
  navigate: t['docsNav.navigate'],
  measure: t['docsNav.measure'],
  style: t['docsNav.style'],
  file: t['docsNav.file'],
  iface: t['docsNav.iface'],
};

// Command names are deliberately kept in English for every language — they
// mirror the literal tokens typed into the in-app terminal, which the docs
// content itself never translates either (see docsNav comment above).
const commandLabels: Record<string, string> = {
  'commands/help': 'Help',
  'commands/line': 'Line',
  'commands/polyline': 'Polyline',
  'commands/rectangle': 'Rectangle',
  'commands/circle': 'Circle',
  'commands/arc': 'Arc',
  'commands/ellipse': 'Ellipse',
  'commands/hatch': 'Hatch',
  'commands/text': 'Text',
  'commands/spline-cv': 'SplineCv',
  'commands/spline-fit': 'SplineFit',
  'commands/move': 'Move',
  'commands/copy': 'Copy',
  'commands/rotate': 'Rotate',
  'commands/mirror': 'Mirror',
  'commands/scale': 'Scale',
  'commands/align': 'Align',
  'commands/array-grid': 'ArrayGrid',
  'commands/delete': 'Delete',
  'commands/clipboard-copy': 'ClipboardCopy',
  'commands/clipboard-paste': 'ClipboardPaste',
  'commands/trim': 'Trim',
  'commands/extend': 'Extend',
  'commands/offset': 'Offset',
  'commands/fillet': 'Fillet',
  'commands/chamfer': 'Chamfer',
  'commands/explode': 'Explode',
  'commands/undo': 'Undo',
  'commands/redo': 'Redo',
  'commands/leader': 'Leader',
  'commands/leader-add': 'LeaderAdd',
  'commands/leader-remove': 'LeaderRemove',
  'commands/dim-linear': 'DimensionLinear',
  'commands/dim-aligned': 'DimensionAligned',
  'commands/dim-continue': 'DimensionContinue',
  'commands/dim-radius': 'DimensionRadius',
  'commands/dim-diameter': 'DimensionDiameter',
  'commands/dim-angular': 'DimensionAngular',
  'commands/layer-make-current': 'LayerMakeCurrent',
  'commands/layer-match': 'LayerMatch',
  'commands/layer-isolate': 'LayerIsolate',
  'commands/layer-unfreeze-all': 'LayerUnfreezeAll',
  'commands/layer-manager': 'LayerManager',
  'commands/viewport-rectangle': 'ViewportRectangle',
  'commands/viewport-copy': 'ViewportCopy',
  'commands/page-manager': 'PageManager',
  'commands/pan': 'Pan',
  'commands/zoom-in': 'ZoomIn',
  'commands/zoom-out': 'ZoomOut',
  'commands/fit': 'Fit',
  'commands/distance': 'Distance',
  'commands/angle': 'Angle',
  'commands/area': 'Area',
  'commands/match-properties': 'MatchProperties',
  'commands/font-add': 'FontAdd',
  'commands/font-manager': 'FontManager',
  'commands/hatch-manager': 'HatchManager',
  'commands/hatch-add': 'HatchAdd',
  'commands/import': 'Import',
  'commands/new-file': 'NewFile',
  'commands/file-manager': 'FileManager',
  'commands/print-manager': 'PrintManager',
  'commands/change-print-area': 'ChangePrintArea',
  'commands/export-manager': 'ExportManager',
  'commands/wipestorage': 'WipeStorage',
  'interface/vector-pins': 'Vector Pins',
  'interface/distance-tracking': 'Distance Tracking',
  'interface/selection-filter': 'Selection Filter',
  'interface/grid-snap': 'Grid & Snap',
  'interface/linetype': 'Linetype',
  'interface/lineweight': 'Lineweight',
  'interface/text-editor': 'Text Editor',
};

function labelFor(id: string, title: string): string {
  if (id === 'index') return s.ref;
  return commandLabels[id] ?? title;
}

// Sidebar grouping/ordering is data-driven from each page's `group` and
// `order` frontmatter (see src/content.config.ts) instead of a hand-maintained
// list, so a new docs page can't silently ship unlinked from the nav.
const collectionName = lang === 'en' ? 'docs' : `docs-${lang}`;
const entries = await getCollection(collectionName as 'docs');

const groupTitles: Record<string, string> = {
  shapes: s.shapes,
  edit: s.edit,
  markup: s.markup,
  layer: s.layer,
  layouts: s.layouts,
  navigate: s.navigate,
  measure: s.measure,
  style: s.style,
  file: s.file,
  interface: s.iface,
};
const groupOrder = ['shapes', 'edit', 'markup', 'layer', 'layouts', 'navigate', 'measure', 'style', 'file', 'interface'] as const;

function itemsForGroup(group: string) {
  return entries
    .filter(e => e.data.group === group)
    .sort((a, b) => a.data.order - b.data.order)
    .map(e => ({
      label: labelFor(e.id, e.data.title),
      href: e.id === 'index' ? `${base}/` : `${base}/${e.id}/`,
    }));
}

const sidebar = [
  { title: s.overview, items: itemsForGroup('overview') },
  ...groupOrder.map(group => ({ title: groupTitles[group], items: itemsForGroup(group) })),
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords.length > 0 ? keywords.join(', ') : undefined}
  lang={lang}
  ogType="article"
  alternates={alternates}
>

    <SiteHeader active="docs" lang={lang} docsSlug={entrySlug} />

    <div class="mx-auto flex max-w-6xl">

      <!-- Sidebar -->
      <aside class="hidden lg:block sticky top-[57px] h-[calc(100vh-57px)] w-64 flex-shrink-0 overflow-y-auto border-r border-slate-800 px-3 py-8">

        <!-- Overview (always visible, not collapsible) -->
        <div class="mb-2">
          {sidebar[0].items.map(item => {
            const active = currentPath === item.href.replace(/\/$/, '');
            return (
              <a
                href={item.href}
                class={`flex items-center gap-2 rounded px-3 py-1.5 text-sm font-medium transition-colors ${
                  active ? 'bg-brand/10 text-brand' : 'text-slate-300 hover:text-slate-50'
                }`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                {item.label}
              </a>
            );
          })}
        </div>

        <div class="my-3 border-t border-slate-800" />

        <!-- Collapsible sections -->
        {sidebar.slice(1).map(group => {
          const isOpen = group.items.some(item => currentPath === item.href.replace(/\/$/, ''));
          return (
            <details open={isOpen} class="group mb-1">
              <summary class="flex cursor-pointer list-none items-center gap-2 rounded px-3 py-1.5 text-xs font-semibold uppercase tracking-widest text-slate-500 hover:text-slate-300 transition-colors select-none">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3 w-3 flex-shrink-0 transition-transform group-open:rotate-90"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                {group.title}
              </summary>
              <ul class="ml-3 mt-0.5 border-l border-slate-800 pl-3">
                {group.items.map(item => {
                  const active = currentPath === item.href.replace(/\/$/, '');
                  return (
                    <li>
                      <a
                        href={item.href}
                        class={`block rounded-r py-1 pl-2 pr-3 text-sm transition-colors ${
                          active
                            ? 'border-l-2 -ml-[1px] border-brand text-brand font-medium bg-brand/5'
                            : 'text-slate-400 hover:text-slate-200'
                        }`}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
      </aside>

      <!-- Content -->
      <main class="min-w-0 flex-1 px-6 py-12 lg:px-16">
        <article class="prose max-w-3xl">
          <slot />
        </article>
      </main>

    </div>

    <SiteFooter lang={lang} />

</Layout>
